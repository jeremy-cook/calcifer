# Copy to .env (ignored). The server reads it at startup; the environment wins.
# A relative sqlite path resolves against server/.
DATABASE_URL=sqlite://./calcifer.db
# Export logs, traces and metrics to the local Grafana LGTM in Docker Desktop's
# Kubernetes (deploy/k8s/infra). Unset, the server only logs to stdout.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
