# macOS Finder metadata.
**/.DS_Store

# JavaScript dependencies, installed by pnpm.
**/node_modules/

# Rust build output.
server/target/
proto/rs/target/

# Local SQLite database and its WAL-mode side files.
server/calcifer.db
server/calcifer.db-shm
server/calcifer.db-wal

# Local server environment (DATABASE_URL for sqlx).
server/.env

# Local fastembed model cache (~90 MB ONNX model, downloaded on first run).
server/.fastembed_cache/

# Per-machine Claude Code state: launch configuration, session locks and worktrees,
# local permissions.
.claude/launch.json
.claude/scheduled_tasks.lock
.claude/worktrees/
.claude/.cc-writes/
**/.claude/settings.local.json

# Working implementation plans, kept out of the repo.
plans/
